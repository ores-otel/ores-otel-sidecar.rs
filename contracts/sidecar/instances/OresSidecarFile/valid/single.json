{
  "schema": "ores.sidecar/config/v1",
  "sidecars": [
    {
      "id": "ores-otel-sidecar",
      "path": ".",
      "startup_config": ".cli-flags.toml",
      "runtime_updates": {
        "provider": "ores-redis-lru-cache",
        "mode": "receive-only",
        "poll_seconds": 180,
        "namespace": "ores-otel-sidecar/runtime"
      },
      "runtime_mutable": ["LOG_FILTER", "REQUEST_TIMEOUT_MS"]
    }
  ]
}
